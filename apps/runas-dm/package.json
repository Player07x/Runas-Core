{
  "name": "@runas/dm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:pages": "npm run build && npm run pages:prepare",
    "pages:prepare": "node scripts/prepare-pages.mjs",
    "deploy:pages": "npm run build:pages && wrangler pages deploy dist/pages --project-name runas-dm --branch main",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "vitest run --config vitest.config.ts --configLoader runner",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@runas/core": "*",
    "@runas/vtt-bridge": "*",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.16.0",
    "next": "16.3.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
